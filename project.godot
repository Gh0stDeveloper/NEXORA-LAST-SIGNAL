; NEXORA: LAST SIGNAL — DEADFALL offline port
config_version=5

[application]
config/name="NEXORA: LAST SIGNAL"
config/version="0.3.0-alpha.1"
config/description="Offline edition of the NEXORA: DEADFALL gameplay experience"
run/main_scene="res://src/main/Boot.tscn"
config/features=PackedStringArray("4.6", "Mobile")

[autoload]
Game="*res://src/autoload/Game.gd"
Settings="*res://src/autoload/Settings.gd"
AudioDirector="*res://src/audio/AudioDirector.gd"
PerformanceTuner="*res://src/mobile/MobilePerformanceTuner.gd"
GuestIdentity="*res://src/identity/GuestIdentity.gd"
Gore="*res://src/gore/GoreManager.gd"
Progress="*res://src/offline/ProgressStore.gd"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true

[input_devices]
pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[physics]
common/physics_ticks_per_second=60
